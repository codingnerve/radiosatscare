# RadioSatCare configuration: ONE file for the whole app.
# Copy to .env.local (used for development AND production; Next.js loads it on start) and fill in real values.
# Never commit .env.local.  chmod 600 .env.local on the server.
#
# NEXT_PUBLIC_* values are inlined into the build, so rebuild (npm run build) after changing them.
# Everything else is read when the server starts: restart after changing it.
#
# There is no database and no login: the contact form emails each enquiry to BUSINESS_EMAIL.

# =====================================================================================
# Public site details (all optional: UI that depends on a missing value is hidden)
# Never invent real contact details: use only numbers and addresses the business actually owns.
# =====================================================================================

# Canonical public URL (canonical links, sitemap, Open Graph, structured data; also the allowed origin for the API).
NEXT_PUBLIC_SITE_URL=https://radiosatscare.com

# Single support number used everywhere on the site, in international format for tel: links.
# The example below is a reserved fictional number: REPLACE it before launch, or leave blank to hide phone CTAs.
NEXT_PUBLIC_SUPPORT_PHONE=+15550100199
# Optional readable version shown to visitors.
NEXT_PUBLIC_SUPPORT_PHONE_DISPLAY=(555) 010-0199

# Optional public support email.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional hours text. Only state hours the business can actually staff. Example: Mon-Fri 9:00-17:00 ET
NEXT_PUBLIC_SUPPORT_HOURS=

# Optional business identity, shown in the footer, About, Contact and legal pages when set.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
# The postal address (2222 West Grand River Avenue, Okemos, MI 48864) is set in lib/site.ts, not here.
# Governing-law jurisdiction for the Terms page, e.g. "England and Wales". Omitted when blank.
NEXT_PUBLIC_BUSINESS_JURISDICTION=

# =====================================================================================
# Email: how enquiries reach you (required: BUSINESS_EMAIL and EMAIL_FROM)
# =====================================================================================
# Inbox that receives every new enquiry. Replying to the email answers the customer.
BUSINESS_EMAIL=support@example.com
# Sender shown on outgoing email. With Brevo it must be a verified sender or domain.
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=RadioSatCare

# brevo = Brevo HTTPS API, smtp = any SMTP server, log = do not send, just print (development only:
# the app refuses to run in production with "log", because enquiries would be lost).
EMAIL_PROVIDER=log

# EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# EMAIL_PROVIDER=smtp (for Brevo SMTP use smtp-relay.brevo.com, port 587)
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS). Defaults from the port when empty.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# =====================================================================================
# Spam protection and networking (the defaults are sensible)
# =====================================================================================
# Reverse proxies in front of the app (Nginx = 1). The visitor's IP, used for rate limits, is read from
# X-Forwarded-For that many hops from the right. Defaults to 1 in production and 0 in development.
# TRUST_PROXY=1
# Extra browser origins allowed to call the API, comma-separated. The site's own origin is always
# allowed, so this is normally left empty.
# CORS_ORIGINS=http://localhost:3000

# Per visitor IP; counted in memory, so run a single instance.
RATE_LIMIT_ENQUIRY_MAX=5
RATE_LIMIT_ENQUIRY_WINDOW_MINUTES=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15

# Optional: log verbosity (debug | info | warn | error | silent).
LOG_LEVEL=info
